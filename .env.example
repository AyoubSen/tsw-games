# PartyKit host for multiplayer features
VITE_PARTYKIT_HOST=your-project.your-username.partykit.dev

# Clerk (web app). CLERK_SECRET_KEY is server-only (SSR middleware).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex (written to .env.local by `npx convex dev`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# PartyKit servers (`partykit env add <NAME>` for deploys; read from here by `partykit dev`)
# Sign-ins are verified with CLERK_SECRET_KEY (above). Optionally set CLERK_JWT_KEY
# (Clerk's PEM public key) to verify without calling Clerk.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-site.netlify.app
CONVEX_SITE_URL=https://your-deployment.convex.site
# Same random value as PARTYKIT_SECRET in the Convex dashboard
PARTYKIT_SECRET=change-me
